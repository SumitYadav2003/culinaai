{% load static %}{
    "name": "CulinaAI",
    "short_name": "CulinaAI",
    "description": "Recipes from the food you have, checked for your diet and allergies, with a meal plan and shopping list.",
    "start_url": "{% url 'dashboard' %}?source=app",
    "scope": "/",
    "display": "standalone",
    "background_color": "#f5f7f5",
    "theme_color": "#2d6a3e",
    "icons": [
        {"src": "{% static 'images/icons/icon-192.png' %}", "sizes": "192x192", "type": "image/png"},
        {"src": "{% static 'images/icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png"},
        {"src": "{% static 'images/icons/maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
    ],
    "shortcuts": [
        {"name": "Shopping list", "url": "{% url 'shopping_list' %}"},
        {"name": "Meal plan", "url": "{% url 'meal_plan' %}"},
        {"name": "New recipe", "url": "{% url 'generate_recipe' %}"}
    ]
}
