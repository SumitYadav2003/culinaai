# Copy this file to .env for local development. Never commit the real .env.

SECRET_KEY=your-secret-key-here

# Turn on Django's debug pages locally. Leave this out on Render (it defaults to off).
DEBUG=True

# PostgreSQL
DB_NAME=culinaai_db
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

OPENAI_API_KEY=your-openai-api-key

# Email (Gmail SMTP locally; Render uses Brevo through django-anymail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password_here
DEFAULT_FROM_EMAIL=your_email@example.com

# Optional. All of these have sensible defaults.
# AI_DAILY_RECIPE_LIMIT=20            # new recipes, changes, versions and fridge scans per user per day
# AI_DAILY_QUESTION_LIMIT=50          # cooking assistant questions per user per day
# EMAIL_CONFIRMATION_REQUIRED=True    # new sign-ups confirm their email before using the AI
# SENTRY_DSN=                         # error tracking; set this on Render only
# DEMO_DAILY_RECIPE_LIMIT=0           # AI recipes a "Try the demo" account may make (0 = none)
# DEMO_HOURS=24                       # demo accounts are deleted after this long
# CRON_SECRET=                        # set on Render and in GitHub secrets for the weekly email job
# SITE_URL=http://127.0.0.1:8000      # used for links in emails sent from the command line
